terraform {
  required_version = ">= 1.6.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

variable "name_prefix" {
  type    = string
  default = "family-trip-planner"
}

variable "ai_provider" {
  type    = string
  default = "gemini"

  validation {
    condition     = contains(["gemini", "openai", "anthropic", "openrouter"], var.ai_provider)
    error_message = "ai_provider must be one of: gemini, openai, anthropic, openrouter."
  }
}

variable "ai_model" {
  type    = string
  default = "gemini-2.5-flash"
}

variable "allowed_origin" {
  type    = string
  default = "*"
}

variable "ai_provider_api_key" {
  type        = string
  default     = null
  sensitive   = true
  nullable    = true
  description = "Optional initial secret value. Prefer setting this outside Git and CI logs. Warning: Terraform state can still contain secret values."
}

resource "aws_secretsmanager_secret" "ai_provider_key" {
  name                    = "${var.name_prefix}/ai-provider-api-key"
  recovery_window_in_days = 7
}

resource "aws_secretsmanager_secret_version" "ai_provider_key_current" {
  count         = var.ai_provider_api_key == null ? 0 : 1
  secret_id     = aws_secretsmanager_secret.ai_provider_key.id
  secret_string = var.ai_provider_api_key
}

# Attach this policy to the Lambda execution role that runs the AI proxy.
resource "aws_iam_policy" "ai_secret_read" {
  name = "${var.name_prefix}-ai-secret-read"

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Action = [
          "secretsmanager:GetSecretValue"
        ]
        Resource = aws_secretsmanager_secret.ai_provider_key.arn
      }
    ]
  })
}

# Example environment block for aws_lambda_function.
# Keep the real key out of Lambda env vars; only pass the secret ARN.
locals {
  lambda_environment = {
    AI_PROVIDER            = var.ai_provider
    AI_MODEL               = var.ai_model
    AI_PROVIDER_SECRET_ARN = aws_secretsmanager_secret.ai_provider_key.arn
    ALLOWED_ORIGIN         = var.allowed_origin
    FUEL_SOURCE_URL        = "https://fuelo.eu/?convertto=eur"
  }
}
